---
// schema.org "LocalBusiness" structured data — THE component that moves the
// needle in local SEO. Google uses it for the business panel in search
// results (hours, phone, reviews...). Everything is generated from
// SITE.business and SITE.openingHours: no data to maintain twice.
// Validate with: https://search.google.com/test/rich-results
import { SITE } from "../config/site";
import { getImage } from "astro:assets";
import { getServices, serviceUrl } from "../lib/services";

// Photo of the business for Google: the hero image as a 1200px JPG
const image = await getImage({ src: SITE.hero.image, width: 1200, format: "jpg" });
const services = await getServices();

// schema.org names days in English
const SCHEMA_DAYS = [
  "Monday",
  "Tuesday",
  "Wednesday",
  "Thursday",
  "Friday",
  "Saturday",
  "Sunday",
];

// Turn the site's opening hours into OpeningHoursSpecification entries,
// skipping closing days.
const hoursSchema = SITE.openingHours
  .filter((h) => !h.closed && h.opens && h.closes)
  .map((h) => ({
    "@type": "OpeningHoursSpecification",
    dayOfWeek: h.days.map((d) => SCHEMA_DAYS[d]),
    opens: h.opens,
    closes: h.closes,
  }));

const data = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      // Google uses this as the site name in search results
      name: SITE.business.name,
      alternateName: SITE.shortName,
      description: SITE.description,
      url: SITE.url,
      inLanguage: SITE.lang,
      publisher: {
        "@id": `${SITE.url}/#business`,
      },
    },
    {
      "@type": SITE.business.schemaType,
      "@id": `${SITE.url}/#business`,
      name: SITE.business.name,
      alternateName: SITE.shortName,
      description: SITE.business.description,
      url: SITE.url,
      telephone: SITE.business.phone,
      email: SITE.business.email,
      image: new URL(image.src, SITE.url).href,
      foundingDate: SITE.business.foundingYear,
      // Opens the location in Google Maps
      hasMap: `https://www.google.com/maps?q=${SITE.business.geo.latitude},${SITE.business.geo.longitude}`,
      priceRange: SITE.business.priceRange,
      address: {
        "@type": "PostalAddress",
        streetAddress: SITE.business.address.street,
        postalCode: SITE.business.address.postalCode,
        addressLocality: SITE.business.address.city,
        addressCountry: SITE.business.address.country,
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: SITE.business.geo.latitude,
        longitude: SITE.business.geo.longitude,
      },
      areaServed: SITE.business.areaServed.map((area) => ({
        "@type": area["@type"],
        name: area.name,
      })),
      // openingHoursSpecification: hoursSchema,
      // What the business offers: one entry per service page
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Schreinerarbeiten nach Maß",
        itemListElement: services.map((service) => ({
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            "@id": `${new URL(serviceUrl(service), SITE.url).href}#service`,
            name: service.data.title,
            url: new URL(serviceUrl(service), SITE.url).href,
          },
        })),
      },
      sameAs: [
        ...SITE.business.socialProfiles,
        SITE.business.googleBusinessUrl,
      ].filter(Boolean),
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
