---
import { SITE } from "../../config/site";

const { faq } = SITE;

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${SITE.url}/#faq`,
  name: "Häufig gestellte Fragen (FAQ) zur Schreinerei in Pocking",
  description: "Antworten auf häufig gestellte Fragen zu unseren Dienstleistungen, Öffnungszeiten, Anfragen und Beratungsterminen in der Schreinerei in Pocking.",
  url: `${SITE.url}/#faq`,
  "isPartOf": {
    "@id": `${SITE.url}/#website`,
  },
  "about": {
    "@id": `${SITE.url}/#business`,
  },
  mainEntity: faq.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container">
    {faq.eyebrow && <p class="section-eyebrow">{faq.eyebrow}</p>}
    <h2 id="faq-title">{faq.title}</h2>

    <div class="faq-list">
      {
        faq.items.map((item) => (
          <details class="faq-item" > <!-- name="faq" einfügen, falls nur ein Feld offen sein soll -->
            <summary>{item.question}</summary>

            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLdFaq)}
/>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: var(--prose-width);

    interpolate-size: allow-keywords;
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    transition: border-color var(--transition);
  }

  .faq-item::details-content {
    block-size: 0;
    overflow-y: clip;

    transition:
      block-size var(--transition),
      content-visibility 300ms allow-discrete;
      opacity var(--transition),
      transform var(--transition),
  }

  .faq-item[open]::details-content {
    block-size: auto;
    opacity: 1;
    transform: translateY(0);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);

    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "+";
    flex: none;

    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1;

    transition: transform var(--transition);
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item.is-closing summary::after {
    transform: rotate(0deg);
  }

  .faq-item summary:hover {
    color: var(--color-accent);
  }

  .faq-answer {
    padding-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .faq-answer p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content {
      transition: none;
    }

    .faq-item[open]::details-content {
      block-size: auto;
    }
  }
</style>
