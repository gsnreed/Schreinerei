---
import { SITE } from "../../config/site";

const { faq } = SITE;

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container">
    {faq.eyebrow && <p class="section-eyebrow">{faq.eyebrow}</p>}
    <h2 id="faq-title">{faq.title}</h2>

    <div class="faq-list">
      {
        faq.items.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>

            <div class="faq-answer-wrapper">
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLdFaq)}
/>

<script>
  const faqItems = document.querySelectorAll<HTMLDetailsElement>(".faq-item");

  faqItems.forEach((item) => {
    const summary = item.querySelector<HTMLElement>("summary");
    const wrapper = item.querySelector<HTMLElement>(".faq-answer-wrapper");

    if (!summary || !wrapper) return;

    let animation: Animation | null = null;

    const setHeight = (height: number | "auto") => {
      wrapper.style.height = height === "auto" ? "auto" : `${height}px`;
    };

    const cleanup = () => {
      animation?.cancel();
      animation = null;

      item.classList.remove("is-closing", "is-opening");
      setHeight("auto");
    };

    const openItem = () => {
      animation?.cancel();

      item.classList.remove("is-closing");
      item.classList.add("is-opening");

      item.setAttribute("open", "");

      // Start at 0 so the opening can animate.
      setHeight(0);

      // Force layout before measuring the target height.
      wrapper.offsetHeight;

      const targetHeight = wrapper.scrollHeight;

      animation = wrapper.animate(
        [
          {
            height: "0px",
            opacity: 0,
            transform: "translateY(-8px)",
          },
          {
            height: `${targetHeight}px`,
            opacity: 1,
            transform: "translateY(0)",
          },
        ],
        {
          duration: 250,
          easing: "ease",
          fill: "forwards",
        },
      );

      animation.onfinish = () => {
        animation = null;
        item.classList.remove("is-opening");
        setHeight("auto");
      };

      animation.oncancel = () => {
        animation = null;
      };
    };

    const closeItem = () => {
      animation?.cancel();

      const startHeight = wrapper.getBoundingClientRect().height;

      item.classList.add("is-closing");
      item.classList.remove("is-opening");

      // Freeze the current height before starting the closing animation.
      setHeight(startHeight);

      animation = wrapper.animate(
        [
          {
            height: `${startHeight}px`,
            opacity: 1,
            transform: "translateY(0)",
          },
          {
            height: "0px",
            opacity: 0,
            transform: "translateY(-8px)",
          },
        ],
        {
          duration: 250,
          easing: "ease",
          fill: "forwards",
        },
      );

      animation.onfinish = () => {
        animation = null;

        item.removeAttribute("open");
        item.classList.remove("is-closing");

        setHeight(0);
      };

      animation.oncancel = () => {
        animation = null;
      };
    };

    summary.addEventListener("click", (event) => {
      event.preventDefault();

      if (item.hasAttribute("open")) {
        closeItem();
      } else {
        openItem();
      }
    });

    // Keep the native <details> behavior sane if something else
    // changes the open attribute.
    item.addEventListener("toggle", () => {
      if (!item.hasAttribute("open") && animation) {
        animation.cancel();
        animation = null;
        item.classList.remove("is-opening", "is-closing");
        setHeight(0);
      }
    });
  });
</script>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: var(--prose-width);
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    transition: border-color var(--transition);
  }

  .faq-item[open] {
    border-color: var(--color-accent);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);

    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "+";
    flex: none;

    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1;

    transition: transform var(--transition);
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item.is-closing summary::after {
    transform: rotate(0deg);
  }

  .faq-item summary:hover {
    color: var(--color-accent);
  }

  .faq-answer-wrapper {
    height: 0;
    overflow: hidden;
  }

  .faq-answer {
    padding-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .faq-answer p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer-wrapper {
      height: auto !important;
    }

    .faq-item summary::after {
      transition: none;
    }
  }
</style>
