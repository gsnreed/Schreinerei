---
// FAQ section using native <details>/<summary>: accessible, zero JavaScript.
// A serif "+" indicator rotates into "×" when an item opens, and the open
// item's border lights up in the accent color.
// SEO bonus: the FAQPage JSON-LD lets Google show the questions directly in
// search results.
import { SITE } from "../../config/site";

const { faq } = SITE;

const jsonLdFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="container">
    {faq.eyebrow && <p class="section-eyebrow">{faq.eyebrow}</p>}
    <h2 id="faq-title">{faq.title}</h2>

    <div class="faq-list">
      {
        faq.items.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <div class="faq-answer-wrapper">
              <p class="faq-answer">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLdFaq)}
/>

<script>
  const faqItems = document.querySelectorAll(".faq-item");

  faqItems.forEach((item) => {
    const summary = item.querySelector("summary");
    const wrapper = item.querySelector<HTMLElement>(".faq-answer-wrapper");

    if (!summary || !wrapper) return;

    summary.addEventListener("click", (event) => {
      event.preventDefault();

      const isOpen = item.hasAttribute("open");

      if (isOpen) {
        item.classList.add("is-closing");
        wrapper.style.height = `${wrapper.scrollHeight}px`;

        requestAnimationFrame(() => {
          wrapper.style.height = "0px";
        });

        wrapper.addEventListener(
          "transitionend",
          () => {
            item.removeAttribute("open");
            item.classList.remove("is-closing");
          },
          { once: true }
        );

        return;
      }

      item.classList.remove("is-closing");
      item.setAttribute("open", "");

      wrapper.style.height = "0px";

      requestAnimationFrame(() => {
        wrapper.style.height = `${wrapper.scrollHeight}px`;
      });

      wrapper.addEventListener(
        "transitionend",
        () => {
          wrapper.style.height = "auto";
        },
        { once: true }
      );
    });
  });
</script>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: var(--prose-width);
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    transition: border-color var(--transition);
  }

  .faq-item[open] {
    border-color: var(--color-accent);
  }

  .faq-item summary {
    font-weight: 600;
    cursor: pointer;
    list-style: none;

    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "+";
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: var(--color-accent);
    line-height: 1;

    transition: transform var(--transition);
    flex: none;
  }

  .faq-item.is-closing summary::after {
    transform: rotate(0deg);
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item summary:hover {
    color: var(--color-accent);
  }

  .faq-answer-wrapper {
    height: 0;
    overflow: hidden;

    transition:
      height var(--transition),
      opacity var(--transition),
      transform var(--transition);

    opacity: 0;
    transform: translateY(-8px);
  }

  .faq-item[open] .faq-answer-wrapper {
    opacity: 1;
    transform: translateY(0);
  }

  .faq-answer {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>