---
// Gallery section: asymmetric grid — the first image is featured (2×2),
// the rest tile around it. Lazy loading, gentle hover zoom with a warm
// bottom gradient (both disabled under prefers-reduced-motion / touch).
// Tip: 5 or 7 images fill the desktop grid perfectly.
//
// Used twice: on the home page it shows the first `gallery.featuredCount`
// images plus a button to /projects/; on /projects/ (`all`) it shows every
// image with the page's <h1>. Same data, same cards.
// Cards come from src/content/projects/ and link to /projects/<slug>/.
import { SITE } from "../../config/site";
import { Image } from "astro:assets";
import { getProjects, projectUrl } from "../../lib/projects";

interface Props {
  /** true on the /projects/ page: every image, h1 heading, no button */
  all?: boolean;
}

const { all = false } = Astro.props;
const { gallery } = SITE;
const allProjects = await getProjects();
const projects = all
  ? allProjects
  : allProjects.slice(0, gallery.featuredCount);
const Heading = all ? "h1" : "h2";
---

<section id={all ? undefined : "gallery"} class="section">
  <div class="container">
    {gallery.eyebrow && <p class="section-eyebrow">{gallery.eyebrow}</p>}
    <Heading>{all ? gallery.allTitle : gallery.title}</Heading>
    <div class="gallery-grid">
      {projects.map((project) => (
        <a class="gallery-item reveal" href={projectUrl(project)}>
          <figure>
            <Image
              src={project.data.image}
              alt={project.data.imageAlt}
              loading={all ? "eager" : "lazy"}
              width="400"
              height="300"
              class="gallery-image"
              transition:name={`project-image-${project.id}`}
            />
            <figcaption class="gallery-caption">
              <span class="gallery-title">{project.data.title}</span>
              {all && (
                <span class="gallery-description">
                  {project.data.description}
                </span>
              )}
            </figcaption>
          </figure>
        </a>
      ))}
    </div>

    {!all && (
      <div class="gallery-action">
        <a href="/projects/" class="button">
          {SITE.ui.allProjectsLabel}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 210px;
    gap: var(--space-2);
  }

  /* Featured first image */
  .gallery-item:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gallery-item {
    display: block;
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden; /* clips the zoomed image */
    position: relative;
    color: #fff;
    text-decoration: none;
    transition: box-shadow var(--transition);
  }

  .gallery-item figure {
    margin: 0;
    height: 100%;
  }

  /* Project name over the bottom gradient: shown on hover/focus, and always
     on touch screens (no hover there) */
  .gallery-caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-2);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--transition),
      transform var(--transition);
  }

  .gallery-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .gallery-description {
    font-size: var(--text-sm);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  /* Warm gradient sweeping up from the bottom on hover */
  .gallery-item::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 62%,
      rgba(29, 20, 13, 0.65) 100%
    );
    opacity: 0;
    transition: opacity var(--transition);
  }

  .gallery-action {
    display: flex;
    justify-content: flex-start;
    margin-top: var(--space-4);
  }

  @media (hover: hover) {
    .gallery-item:hover .gallery-image {
      transform: scale(1.05);
    }

    .gallery-item:hover {
      box-shadow: var(--shadow-lift);
    }

    .gallery-item:hover::after,
    .gallery-item:hover .gallery-caption {
      opacity: 1;
      transform: none;
    }
  }

  .gallery-item:focus-visible .gallery-image {
    transform: scale(1.05);
  }

  .gallery-item:focus-visible::after,
  .gallery-item:focus-visible .gallery-caption {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .gallery-item::after,
    .gallery-caption {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 820px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }

    .gallery-caption {
      padding: var(--space-1) 0.75rem;
    }

    .gallery-title {
      font-size: var(--text-base);
    }

    .gallery-description {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item:hover .gallery-image,
    .gallery-item:focus-visible .gallery-image {
      transform: none;
    }
  }
</style>
