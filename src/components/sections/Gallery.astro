---
// Gallery section: asymmetric grid — the first image is featured (2×2),
// the rest tile around it. Lazy loading, gentle hover zoom with a warm
// bottom gradient (both disabled under prefers-reduced-motion / touch).
// Tip: 5 or 7 images fill the desktop grid perfectly.
//
// Used twice: on the home page it shows the first `gallery.featuredCount`
// images plus a button to /projects/; on /projects/ (`all`) it shows every
// image with the page's <h1>. Same data, same cards.
import { SITE } from "../../config/site";
import { Image } from "astro:assets";

interface Props {
  /** true on the /projects/ page: every image, h1 heading, no button */
  all?: boolean;
}

const { all = false } = Astro.props;
const { gallery } = SITE;
const images = all
  ? gallery.images
  : gallery.images.slice(0, gallery.featuredCount);
const Heading = all ? "h1" : "h2";
---

<section id={all ? undefined : "gallery"} class="section">
  <div class="container">
    {gallery.eyebrow && <p class="section-eyebrow">{gallery.eyebrow}</p>}
    <Heading>{all ? gallery.allTitle : gallery.title}</Heading>
    <div class="gallery-grid">
      {images.map((image) => (
        <figure class="gallery-item reveal">
          <Image
            src={image.src}
            alt={image.alt}
            loading="lazy"
            width="400"
            height="300"
            class="gallery-image"
          />
        </figure>
      ))}
    </div>

    {!all && (
      <div class="gallery-action">
        <a href="/projects/" class="button">
          {SITE.ui.allProjectsLabel}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 210px;
    gap: var(--space-2);
  }

  /* Featured first image */
  .gallery-item:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }

  .gallery-item {
    margin: 0;
    border-radius: var(--radius-sm);
    overflow: hidden; /* clips the zoomed image */
    position: relative;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  /* Warm gradient sweeping up from the bottom on hover */
  .gallery-item::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 62%,
      rgba(29, 20, 13, 0.5) 100%
    );
    opacity: 0;
    transition: opacity var(--transition);
  }

  .gallery-action {
    display: flex;
    justify-content: flex-start;
    margin-top: var(--space-4);
  }

  @media (hover: hover) {
    .gallery-item:hover .gallery-image {
      transform: scale(1.05);
    }

    .gallery-item:hover::after {
      opacity: 1;
    }
  }

  @media (max-width: 820px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item:hover .gallery-image {
      transform: none;
    }
  }
</style>
