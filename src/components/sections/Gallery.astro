---
// Home page projects section: the projects marked `star: true` (at most
// `gallery.featuredCount`, alphabetically) as cards, plus a button to
// /projekte/ — shown only when that page actually has more to offer.
// Cards come from src/content/projects/ and link to /projekte/<slug>/.
import { SITE } from "../../config/site";
import ProjectCard from "../ProjectCard.astro";
import { getProjects, getFeaturedProjects, getServiceTitles } from "../../lib/projects";

const { gallery, ui } = SITE;
const [allProjects, projects, serviceTitles] = await Promise.all([
  getProjects(),
  getFeaturedProjects(),
  getServiceTitles(),
]);
const hasMore = allProjects.length > projects.length;
---

<section id="gallery" class="section">
  <div class="container">
    {gallery.eyebrow && <p class="section-eyebrow">{gallery.eyebrow}</p>}
    <h2>{gallery.title}</h2>
    <div class="grid-3 gallery-grid">
      {projects.map((project) => (
        <ProjectCard
          project={project}
          serviceTitle={serviceTitles.get(project.data.service.id)}
        />
      ))}
    </div>

    {hasMore && (
      <div class="gallery-action">
        <a href="/projekte/" class="button">
          {ui.allProjectsLabel.replace("{count}", String(allProjects.length))}
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .gallery-grid {
    margin-top: var(--space-3);
  }

  .gallery-action {
    margin-top: var(--space-4);
  }
</style>
