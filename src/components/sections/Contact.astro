---
// Contact section: form with a honeypot anti-spam field.
// Two modes depending on SITE.contact.endpoint:
//  - endpoint set (Formspree, Basin, or your own backend)
//    → the form POSTs to it.
//  - endpoint empty → no form: a prominent mailto button is shown instead
//    (a broken form is worse than no form).
import { SITE } from "../../config/site";

const { contact, business, ui } = SITE;
const hasEndpoint = contact.endpoint.length > 0;

const sent = Astro.url.searchParams.get("sent");
const formSuccess = sent === "1";
const formError = sent === "0";
---

<section id="contact" class="section">
  <div class="container">
    {contact.eyebrow && <p class="section-eyebrow">{contact.eyebrow}</p>}
    <h2>{contact.title}</h2>
    <p class="intro">{contact.intro}</p>

    {
      formSuccess && (
        <div class="form-status form-status-success" role="status">
          <div class="form-status-icon" aria-hidden="true">
            ✓
          </div>
          <div>
            <strong>Vielen Dank für Ihre Anfrage!</strong>
            <p>
              Ihre Nachricht wurde erfolgreich übermittelt. Wir melden uns so
              schnell wie möglich bei Ihnen.
            </p>
          </div>
        </div>
      )
    }

    {
      formError && (
        <div class="form-status form-status-error" role="alert">
          <div class="form-status-icon" aria-hidden="true">
            !
          </div>
          <div>
            <strong>Ihre Nachricht konnte leider nicht gesendet werden.</strong>
            <p>
              Bitte versuchen Sie es erneut oder kontaktieren Sie uns direkt per
              E-Mail oder Telefon.
            </p>
          </div>
        </div>
      )
    }

    {
      hasEndpoint ? (
        <form class="contact-form card" method="POST" action={contact.endpoint}>
          {/* Honeypot anti-spam: a field invisible to humans. Bots fill it in —
              the backend rejects any submission where it is not empty. */}
          <div class="hp" aria-hidden="true">
            <label for={contact.honeypotField}>{ui.formHoneypotLabel}</label>
            <input
              type="text"
              id={contact.honeypotField}
              name={contact.honeypotField}
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="contact-grid">
            <div>
              <label for="name">{ui.formNameLabel}</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
              />
            </div>
            <div>
              <label for="email">{ui.formEmailLabel}</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
              />
            </div>
            <div>
              <label for="telephone">{ui.formTelephoneLabel}</label>
              <input
                type="tel"
                id="telephone"
                name="telephone"
                required
                autocomplete="tel"
              />
            </div>
          </div>

          <label for="message">{ui.formMessageLabel}</label>
          <textarea id="message" name="message" rows="5" required />

          <div class="privacy-consent">
            <label for="privacy-consent">
              <input
                type="checkbox"
                id="privacy-consent"
                name="privacy_consent"
                value="yes"
                required
              />
              <span>
                Ich akzeptiere die
                <a href="/privacy-policy/">Datenschutzerklärung</a>
                und stimme der Verarbeitung meiner Angaben zur Bearbeitung
                meiner Anfrage zu.
              </span>
            </label>
          </div>

          <button class="button" type="submit">
            {ui.formSubmitLabel}
          </button>
        </form>
      ) : (
        <p>
          <a class="button" href={`mailto:${business.email}`}>
            {business.email}
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .intro {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .contact-form {
    max-width: 640px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 0 var(--space-2);
  }

  .contact-grid > div:first-child {
    grid-column: 1 / -1;
  }

  .privacy-consent {
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .privacy-consent label {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.6rem;

    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .privacy-consent input {
    width: 1rem;
    height: 1rem;
    margin: 0.2rem 0 0;
    accent-color: var(--color-accent);
  }

  .privacy-consent a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .privacy-consent a:hover {
    color: var(--color-accent);
  }

  /* Honeypot: visually hidden but present in the DOM for bots */
  .hp {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }

  #message {
    resize: none;
  }

  .form-status {
    max-width: 640px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;

    margin-bottom: var(--space-2);
    padding: 1.1rem 1.25rem;

    border-radius: 0.75rem;
    border: 1px solid;
  }

  .form-status strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .form-status p {
    margin: 0;
    line-height: 1.5;
  }

  .form-status-icon {
    width: 2rem;
    height: 2rem;

    display: grid;
    place-items: center;

    border-radius: 50%;
    font-weight: 700;
    flex-shrink: 0;
  }

  .form-status-success {
    color: #155724;
    background: #edf8f0;
    border-color: #b8dfc2;
  }

  .form-status-success .form-status-icon {
    color: white;
    background: #2e8b57;
  }

  /* Fehler */

  .form-status-error {
    color: #842029;
    background: #fff1f2;
    border-color: #f3b8bd;
  }

  .form-status-error .form-status-icon {
    color: white;
    background: #c0392b;
  }
</style>
