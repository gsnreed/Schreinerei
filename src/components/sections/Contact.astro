---
// Contact section: form with a honeypot anti-spam field.
// Two modes depending on SITE.contact.endpoint:
//  - endpoint set (Formspree, Basin, or your own backend)
//    → the form POSTs to it.
//  - endpoint empty → no form: a prominent mailto button is shown instead
//    (a broken form is worse than no form).
//
// Submission: works as a plain POST + redirect (?sent=1 / ?sent=0&reason=…)
// without JavaScript. With JavaScript, the script below sends it in the
// background (Accept: application/json), shows a loading state, prevents
// double submits, shows field errors and keeps the input on errors.
// Field limits must match MAX_LENGTH in public/server/contact.php.
import { SITE } from "../../config/site";

const { contact, business, ui } = SITE;
const hasEndpoint = contact.endpoint.length > 0;

const maxLength = { name: 150, email: 254, telephone: 50, message: 5000 };
---

<section id="contact" class="section">
  <div class="container">
    {contact.eyebrow && <p class="section-eyebrow">{contact.eyebrow}</p>}
    <h2>{contact.title}</h2>
    <p class="intro">{contact.intro}</p>

    <div
      id="form-success"
      class="form-status form-status-success"
      role="status"
      tabindex="-1"
      hidden
    >
      <div class="form-status-icon" aria-hidden="true">✓</div>
      <div>
        <strong>Vielen Dank für Ihre Anfrage!</strong>
        <p>
          Ihre Nachricht wurde erfolgreich übermittelt. Wir melden uns so
          schnell wie möglich bei Ihnen.
        </p>
      </div>
    </div>

    <div
      id="form-error"
      class="form-status form-status-error"
      role="alert"
      tabindex="-1"
      hidden
    >
      <div class="form-status-icon" aria-hidden="true">!</div>
      <div>
        <strong>Ihre Nachricht konnte leider nicht gesendet werden.</strong>
        <p data-error-text>
          Bitte versuchen Sie es erneut oder kontaktieren Sie uns direkt per
          E-Mail oder Telefon.
        </p>
        <p>
          Telefon: <a href={`tel:${business.phone.replace(/\s/g, "")}`}>{business.phone}</a>
          · E-Mail: <a href={`mailto:${business.email}`}>{business.email}</a>
        </p>
      </div>
    </div>

    {
      hasEndpoint ? (
        <form
          id="contact-form"
          class="contact-form card"
          method="POST"
          action={contact.endpoint}
          data-astro-reload
          data-prefill={ui.similarProjectMessage}
        >
          {/* Honeypot anti-spam: a field invisible to humans. Bots fill it in —
              the backend rejects any submission where it is not empty. */}
          <div class="hp" aria-hidden="true">
            <label for={contact.honeypotField}>{ui.formHoneypotLabel}</label>
            <input
              type="text"
              id={contact.honeypotField}
              name={contact.honeypotField}
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="contact-grid">
            <div>
              <label for="name">
                {ui.formNameLabel}
                <span class="required">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                maxlength={maxLength.name}
                aria-describedby="name-error"
                required
                autocomplete="name"
              />
              <p class="field-error" id="name-error" hidden />
            </div>
            <div>
              <label for="email">
                {ui.formEmailLabel}
                <span class="required">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                maxlength={maxLength.email}
                aria-describedby="email-error"
                required
                autocomplete="email"
              />
              <p class="field-error" id="email-error" hidden />
            </div>
            <div>
              <label for="telephone">{ui.formTelephoneLabel}</label>
              <input
                type="tel"
                id="telephone"
                name="telephone"
                maxlength={maxLength.telephone}
                aria-describedby="telephone-error"
                autocomplete="tel"
              />
              <p class="field-error" id="telephone-error" hidden />
            </div>
          </div>

          <label for="message">
            {ui.formMessageLabel}
            <span class="required">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            maxlength={maxLength.message}
            aria-describedby="message-error"
          />
          <p class="field-error" id="message-error" hidden />

          <div class="privacy-consent">
            <label for="privacy-consent">
              <input
                type="checkbox"
                id="privacy-consent"
                name="privacy_consent"
                value="yes"
                required
                aria-describedby="privacy_consent-error"
              />
              <span>
                Ich akzeptiere die
                <a href="/privacy-policy/">Datenschutzerklärung</a>
                und stimme der Verarbeitung meiner Angaben zur Bearbeitung
                meiner Anfrage zu.<span class="required">*</span>
              </span>
            </label>
            <p class="field-error" id="privacy_consent-error" hidden />
          </div>

          {/* Filled in by the script: time spent on the form (bot check) */}
          <input type="hidden" name="form_elapsed" value="" />

          <button class="button" type="submit" data-label={ui.formSubmitLabel}>
            {ui.formSubmitLabel}
          </button>
        </form>
      ) : (
        <p>
          <a class="button" href={`mailto:${business.email}`}>
            {business.email}
          </a>
        </p>
      )
    }
  </div>
  <script>
    const MESSAGES: Record<string, string> = {
      validation: "Bitte prüfen Sie Ihre Eingaben.",
      rate_limited:
        "Zu viele Anfragen in kurzer Zeit. Bitte versuchen Sie es in einigen Minuten erneut.",
      network:
        "Keine Verbindung zum Server. Bitte prüfen Sie Ihre Internetverbindung und versuchen Sie es erneut.",
      default:
        "Bitte versuchen Sie es erneut oder kontaktieren Sie uns direkt per E-Mail oder Telefon.",
    };

    document.addEventListener("astro:page-load", () => {
      const form = document.getElementById("contact-form") as HTMLFormElement | null;
      const success = document.getElementById("form-success");
      const error = document.getElementById("form-error");
      const errorText = error?.querySelector<HTMLElement>("[data-error-text]");
      if (!success || !error) return;

      const showSuccess = () => {
        error.hidden = true;
        success.hidden = false;
        success.focus();
      };
      const showError = (code: string, message?: string) => {
        success.hidden = true;
        if (errorText) errorText.textContent = message || MESSAGES[code] || MESSAGES.default;
        error.hidden = false;
        error.focus();
      };

      // Result of the no-JavaScript flow (redirect back with ?sent=…)
      const params = new URLSearchParams(window.location.search);
      if (params.get("sent") === "1") showSuccess();
      if (params.get("sent") === "0") showError(params.get("reason") ?? "default");

      if (!form) return;

      // Coming from a project page ("Ähnliches Projekt anfragen" → /?projekt=…):
      // start the message with the project name, unless the visitor already typed.
      const project = params.get("projekt");
      const message = form.querySelector<HTMLTextAreaElement>("#message");
      if (project && message && !message.value && form.dataset.prefill) {
        message.value = form.dataset.prefill.replace("{project}", project.slice(0, 120));
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const elapsedField = form.querySelector<HTMLInputElement>('input[name="form_elapsed"]');
      const startedAt = Date.now();
      let sending = false;

      const clearFieldErrors = () => {
        form.querySelectorAll<HTMLElement>(".field-error").forEach((el) => {
          el.hidden = true;
          el.textContent = "";
        });
        form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
      };

      const showFieldErrors = (errors: Record<string, string>) => {
        let first: HTMLElement | null = null;
        for (const [name, text] of Object.entries(errors)) {
          const input = form.elements.namedItem(name) as HTMLElement | null;
          const slot = document.getElementById(`${name}-error`);
          if (slot) {
            slot.textContent = text;
            slot.hidden = false;
          }
          input?.setAttribute("aria-invalid", "true");
          first ??= input;
        }
        first?.focus();
      };

      const setSending = (state: boolean) => {
        sending = state;
        form.setAttribute("aria-busy", String(state));
        if (button) {
          button.disabled = state;
          button.textContent = state ? "Wird gesendet …" : (button.dataset.label ?? "");
        }
      };

      form.addEventListener("submit", async (event) => {
        // Native validation already passed (otherwise no submit event).
        event.preventDefault();
        if (sending) return;

        if (elapsedField) elapsedField.value = String(Date.now() - startedAt);
        clearFieldErrors();
        setSending(true);

        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 20000);

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
            signal: controller.signal,
          });

          let data: { ok?: boolean; code?: string; message?: string; errors?: Record<string, string> } = {};
          if (response.headers.get("content-type")?.includes("application/json")) {
            data = await response.json().catch(() => ({}));
          }

          if (response.ok && data.ok) {
            form.reset();
            form.hidden = true;
            showSuccess();
            return;
          }

          if (response.status === 422 && data.errors) {
            showFieldErrors(data.errors);
            if (errorText) errorText.textContent = data.message || MESSAGES.validation;
            error.hidden = false;
            success.hidden = true;
            return;
          }

          // 429, 4xx/5xx, or a non-JSON answer (e.g. PHP not running)
          showError(data.code ?? "default", data.message);
        } catch {
          showError("network");
        } finally {
          clearTimeout(timeout);
          setSending(false);
        }
      });
    });
  </script>
</section>

<style>
  .required {
    color: #dc2626;
    font-weight: 700;
  }

  .intro {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .contact-form {
    max-width: 640px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 0 var(--space-2);
  }

  .contact-grid > div:first-child {
    grid-column: 1 / -1;
  }

  .privacy-consent {
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .privacy-consent label {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.6rem;

    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .privacy-consent input {
    width: 1rem;
    height: 1rem;
    margin: 0.2rem 0 0;
    accent-color: var(--color-accent);
  }

  .privacy-consent a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .privacy-consent a:hover {
    color: var(--color-accent);
  }

  /* Honeypot: visually hidden but present in the DOM for bots */
  .hp {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }

  #message {
    resize: none;
  }

  .form-status {
    max-width: 640px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;

    margin-bottom: var(--space-2);
    padding: 1.1rem 1.25rem;

    border-radius: 0.75rem;
    border: 1px solid;
  }

  .form-status strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .form-status p {
    margin: 0;
    line-height: 1.5;
  }

  .form-status-icon {
    width: 2rem;
    height: 2rem;

    display: grid;
    place-items: center;

    border-radius: 50%;
    font-weight: 700;
    flex-shrink: 0;
  }

  .form-status-success {
    color: #155724;
    background: #edf8f0;
    border-color: #b8dfc2;
  }

  .form-status-success .form-status-icon {
    color: white;
    background: #2e8b57;
  }

  /* Fehler */

  .form-status-error {
    color: #842029;
    background: #fff1f2;
    border-color: #f3b8bd;
  }

  .form-status-error .form-status-icon {
    color: white;
    background: #c0392b;
  }

  .field-error {
    margin: -0.5rem 0 var(--space-2);
    color: #b91c1c;
    font-size: var(--text-sm);
  }

  [aria-invalid="true"] {
    border-color: #b91c1c;
  }

  .contact-form button[disabled] {
    opacity: 0.7;
    cursor: progress;
    transform: none;
  }

  .form-status:focus {
    outline: none;
  }

  .form-status a {
    color: inherit;
    text-decoration: underline;
  }

  .form-status p + p {
    margin-top: 0.4rem;
  }

  .form-status[hidden] {
    display: none;
  }
</style>
