---
// Services/products section: a card grid driven by SITE.services.
// Icons are real inline SVGs in a gradient chip (see Icon.astro) — never
// emoji. Each card carries a serif index number that lights up on hover.
// Tiles come from the MDX files in src/content/services/ and each one links
// to its detail page (src/pages/leistungen/[...slug].astro).
import { SITE } from "../../config/site";
import Icon from "../Icon.astro";
import { getServices, serviceUrl } from "../../lib/services";

const { services } = SITE;
const items = await getServices();

const jsonLdServices = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${SITE.url}/#services`,
  name: "Schreinerarbeiten nach Maß in Pocking",
  description: "Möbel nach Maß, Innenausbau, Küchen, Türen, Treppen sowie Reparatur und Restaurierung in Pocking, im Landkreis Passau und in Niederbayern.",
  numberOfItems: items.length,
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Service",
      name: item.data.title,
      description: item.data.description,
      url: new URL(serviceUrl(item), SITE.url).href,
      provider: {
        "@id": `${SITE.url}/#business`,
      }
    }
  })),
};
---

<section id="services" class="section">
  <div class="container">
    {services.eyebrow && <p class="section-eyebrow">{services.eyebrow}</p>}
    <h2>{services.title}</h2>
    <p class="intro">{services.intro}</p>
    <div class="grid-3">
      {
        items.map((item, index) => (
          <a class="card service-card reveal" href={serviceUrl(item)}>
            <span class="service-index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <span class="service-icon" aria-hidden="true">
              <Icon name={item.data.icon} size={30} />
            </span>
            <h3 class="service-title" transition:name={`service-title-${item.id}`}>
              {item.data.title}
            </h3>
            <p class="service-description" transition:name={`service-description-${item.id}`}>
              {item.data.description}
            </p>
            <span class="service-more" aria-hidden="true">
              {SITE.ui.serviceMoreLabel} <span class="service-arrow">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLdServices)} />

<style>
  .intro {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  /* The whole card is the link: keep the card look, not link styling */
  .service-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .service-card:hover {
    color: inherit;
  }

  /* Tight box around the text, so it morphs cleanly into the detail
     page's <h1> (same transition:name) */
  .service-title {
    width: fit-content;
  }

  .service-icon {
    transition:
      transform var(--transition),
      box-shadow var(--transition);
    color: #fff;
    background: var(--gradient-icon);
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 var(--space-2);
    box-shadow: 0 6px 16px rgba(146, 64, 14, 0.3);
  }

  .service-index {
    position: absolute;
    top: var(--space-2);
    right: var(--space-3);
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-border);
    transition: color var(--transition);
  }

  .service-more {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
  }

  .service-arrow {
    display: inline-block;
    transition: transform var(--transition);
  }

  @media (hover: hover) {
    .card:hover .service-index {
      color: var(--color-accent-bright);
    }

    .card:hover .service-arrow {
      transform: translateX(4px);
    }

    .card:hover .service-icon {
      transform: translateY(-2px) scale(1.04);
      box-shadow: 0 10px 22px rgba(146, 64, 14, 0.36);
    }
  }

  .service-card:focus-visible .service-arrow {
    transform: translateX(4px);
  }

  .service-description {
    view-transition-class: service-text;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
