---
// Sticky dark header with a subtle blur: business name + navigation.
// On mobile the menu opens via a burger button (the tiny script at the
// bottom is the ONLY JavaScript on the whole site — maximum performance).
import { SITE } from "../config/site";
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <span class="brand-name">
        {SITE.brand}
      </span>
      <span class="brand-owner">
        {SITE.name}
      </span>
    </a>

    <button
      id="menu-burger"
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu"
      aria-label={SITE.ui.menuOpenLabel}
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="main-menu" class="nav">
      {SITE.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-dark-bg) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(247, 240, 228, 0.12);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 70px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 1;
    color: var(--color-dark-text);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-accent-bright);
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    transition: color var(--transition);
  }

  .brand-owner {
    margin: 0;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-dark-text-muted);
  }

  .nav {
    position: relative;
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .nav a {
    position: relative;
    display: inline-block;
    color: var(--color-dark-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    transition: color var(--transition);
    padding-bottom: 6px;
  }

  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--color-accent-bright);

    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }

  .nav a:hover {
    color: var(--color-accent-bright);
  }

  .nav a:hover::after {
    transform: scaleX(1);
  }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 32px;
    height: 24px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .burger span {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: var(--color-dark-text);

    transition:
      transform var(--transition),
      opacity var(--transition);
    transform-origin: center;
  }

  .burger.open span:nth-child(1) {
    transform: translateY(11px) rotate(45deg);
  }

  .burger.open span:nth-child(2) {
    opacity: 0;
  }

  .burger.open span:nth-child(3) {
    transform: translateY(-11px) rotate(-45deg);
  }

  @media (max-width: 820px) {
    .burger {
      display: flex;
    }

    .nav {
      position: absolute;
      top: 70px;
      left: 0;
      right: 0;

      display: flex;
      flex-direction: column;
      gap: 0;

      background: var(--color-dark-bg);
      border-bottom: 1px solid rgba(247, 240, 228, 0.12);

      /* geschlossen */
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-12px);

      /* Animation */
      transition:
        opacity 300ms ease,
        transform 300ms ease,
        visibility 300ms ease;
    }

    /* geöffnet */
    .nav.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .nav a {
      padding: var(--space-2) var(--space-3);
      border-top: 1px solid rgba(247, 240, 228, 0.12);
    }
  }
</style>

<script>
  // Mobile menu: ~10 lines of JS — the entire JavaScript budget of the site.
  const burger = document.getElementById("menu-burger");
  const menu = document.getElementById("main-menu");

  burger?.addEventListener("click", () => {
    const open = menu?.classList.toggle("open");
    burger?.classList.toggle("open", Boolean(open));
    burger.setAttribute("aria-expanded", String(Boolean(open)));
  });

  // Close the menu when a link is clicked (anchor navigation)
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "A") {
      menu.classList.remove("open");
      burger?.classList.remove("open");
      burger?.setAttribute("aria-expanded", "false");
    }
  });
</script>
