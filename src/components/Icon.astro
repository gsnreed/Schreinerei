---
// Inline SVG icon set — no emoji, no icon-font download, inherits currentColor.
// Lucide-inspired stroke style (24×24 grid, rounded caps).
// Add a business-specific icon: add an entry to PATHS below, then use its key
// in SITE.services.items[].icon. Unknown keys fall back to "sparkles".
interface Props {
  /** Icon key (see PATHS below) */
  name: string;
  /** Rendered size in px */
  size?: number;
}

const { name, size = 28 } = Astro.props;

const PATHS: Record<string, string> = {
  wardrobe: `
    <path d="M5 3h14v18H5z"/>
    <path d="M12 3v18"/>
    <path d="M9 8h.01"/>
    <path d="M15 8h.01"/>
    <path d="M9 16h.01"/>
    <path d="M15 16h.01"/>
  `,

  home: `
    <path d="m3 11 9-8 9 8"/>
    <path d="M5 10v10h14V10"/>
    <path d="M9 20v-6h6v6"/>
  `,

  kitchen: `
    <path d="M4 4h16v16H4z"/>
    <path d="M4 10h16"/>
    <path d="M4 16h16"/>
    <path d="M8 7h.01"/>
    <path d="M12 7h.01"/>
    <path d="M16 7h.01"/>
    <path d="M8 13h.01"/>
    <path d="M16 13h.01"/>
  `,

  stairs: `
    <path d="M4 20h16"/>
    <path d="M4 20v-4h4v-4h4V8h4V4h4"/>
    <path d="M8 16h4"/>
    <path d="M12 12h4"/>
    <path d="M16 8h4"/>
  `,

  tools: `
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
  `,

  wood: `
    <rect x="4" y="4" width="16" height="16" rx="1"/>
    <path d="M7 7c2 2 2 4 0 6s-2 4 0 6"/>
    <path d="M12 7c2 2 2 4 0 6s-2 4 0 6"/>
    <path d="M17 7c-2 2-2 4 0 6s2 4 0 6"/>
  `,

  ruler: `
    <path d="M4 20 20 4"/>
    <path d="m7 17 3 3"/>
    <path d="m10 14 2 2"/>
    <path d="m13 11 3 3"/>
    <path d="m16 8 2 2"/>
  `,

  hammer: `
    <path d="m14 4 6 6"/>
    <path d="m17 7-8.5 8.5a2.12 2.12 0 0 1-3 0l-1-1a2.12 2.12 0 0 1 0-3L13 5"/>
    <path d="m4 20 5-5"/>
  `,

  sparkles: `
    <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/>
  `,
};

const inner = PATHS[name] ?? PATHS.sparkles;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
