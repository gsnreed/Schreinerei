---
// SEO component: every <head> tag related to search and sharing.
// Used by the Base layout — each page passes its own title/description.
// This is the theme's "technical SEO" module: canonical URL, Open Graph,
// Twitter cards. The JSON-LD LocalBusiness markup is a separate component.
import { SITE } from "../config/site";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  title: string;
  description: string;
  /** Share image (imported image). Defaults to the hero image. */
  image?: ImageMetadata;
  /** Alt text of the share image */
  imageAlt?: string;
  /** Open Graph type: "website" (default) or "article" (detail pages) */
  ogType?: "website" | "article";
  /** true on pages that must not be indexed (legal notice, 404...) */
  noindex?: boolean;
  /** Path of the original page if this one is a variant of it (e.g. the
      photo pages of a project point to the project page) */
  canonical?: string;
}

const {
  title,
  description,
  image = SITE.hero.image,
  imageAlt = SITE.hero.imageAlt,
  ogType = "website",
  noindex = false,
  canonical: canonicalPath,
} = Astro.props;

// Absolute canonical URL of the current page — essential to avoid duplicate
// content issues (www/non-www, with/without trailing slash...)
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
// Share image in the size Facebook/WhatsApp/LinkedIn expect (1200×630, JPG),
// instead of the multi-megabyte original
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
const ogImage = await getImage({
  src: image,
  width: OG_WIDTH,
  height: OG_HEIGHT,
  fit: "cover",
  format: "jpg",
});
const absoluteImage = new URL(ogImage.src, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
{/* noindex pages (legal, 404) get no canonical: the 404 page has no URL of
    its own, and the others shouldn't be promoted to search engines */}
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<!-- Open Graph: link preview when shared (Facebook, LinkedIn, WhatsApp...) -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={`${SITE.brand} ${SITE.name}`} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={SITE.ogLocale} />

<!-- Twitter/X card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:image:alt" content={imageAlt} />
