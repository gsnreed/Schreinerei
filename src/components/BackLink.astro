---
// Small "← label" link at the top of sub-pages (projects, services).
// One component so every page offers the way back in the same place and style.
import Icon from "./Icon.astro";

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="back-link" href={href}>
  <Icon name="arrow-left" size={16} />
  {label}
</a>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .back-link :global(svg) {
    transition: transform var(--transition);
  }

  @media (hover: hover) {
    .back-link:hover :global(svg) {
      transform: translateX(-3px);
    }
  }
</style>
