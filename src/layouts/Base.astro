---
// Base layout: the HTML skeleton shared by every page.
import "../styles/global.css";
import { SITE } from "../config/site";
import Seo from "../components/Seo.astro";
import JsonLdLocalBusiness from "../components/JsonLdLocalBusiness.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  /** true on pages that must not be indexed (legal, 404) */
  noindex?: boolean;
  /** The JSON-LD LocalBusiness markup is only useful on the home page */
  withJsonLd?: boolean;
  /** Share image for Open Graph / Twitter (defaults to the hero image) */
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: "website" | "article";
  /** Canonical path, if this page is a variant of another one */
  canonical?: string;
}

const {
  title,
  description,
  noindex = false,
  withJsonLd = false,
  image,
  imageAlt,
  ogType,
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      title={title}
      description={description}
      noindex={noindex}
      image={image}
      imageAlt={imageAlt}
      ogType={ogType}
      canonical={canonical}
    />
    {withJsonLd && <JsonLdLocalBusiness />}
    <!-- Page-specific structured data (JSON-LD) -->
    <slot name="head" />
    <!-- View transitions between pages (cards → detail pages and back).
         Browsers without native support get Astro's fallback animation;
         prefers-reduced-motion disables the animations. -->
    <ClientRouter />
  </head>
  <body>
    <a href="#content" class="skip-link">{SITE.ui.skipToContent}</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Shared-element morph (e.g. card image → large project image): wait
  // briefly until the new page's named images are decoded, so the morph
  // doesn't land on an empty box. Capped at 400 ms — never blocks navigation.
  document.addEventListener("astro:before-preparation", (event) => {
    const load = event.loader;
    event.loader = async () => {
      await load();
      const images = [
        ...(event.newDocument?.querySelectorAll<HTMLImageElement>(
          "img[data-astro-transition-scope]",
        ) ?? []),
      ];
      if (!images.length) return;
      const decoded = images.map((source) => {
        const img = new Image();
        img.sizes = source.sizes;
        img.srcset = source.srcset;
        img.src = source.src;
        return img.decode().catch(() => {});
      });
      await Promise.race([
        Promise.all(decoded),
        new Promise((resolve) => setTimeout(resolve, 400)),
      ]);
    };
  });
</script>
