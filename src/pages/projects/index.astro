---
// Projects overview: every project from src/content/projects/ as cards,
// with filter chips per service (see ProjectsListing.astro).
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config/site";
import ProjectsListing from "../../components/ProjectsListing.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
---

<Base
  title={`${SITE.gallery.allTitle} — ${SITE.brand} ${SITE.name}`}
  description={`Projekte der ${SITE.business.name}: Küchen, Treppen, Böden und Möbel nach Maß aus unserer Werkstatt in ${SITE.business.address.city}.`}
>
  <ProjectsListing />
  <CtaBanner />
</Base>
