---
// Legal notice ("mentions légales" / "Impressum") — mandatory for
// professional sites in many EU countries.
// The identity block is generated from SITE.legal; the prose below is a
// generic English template: ADAPT IT to your jurisdiction and language.
// (A French version is provided in examples/french-bakery/.)
import Base from "../layouts/Base.astro";
import { SITE } from "../config/site";

const { legal, business, ui } = SITE;
---

<Base
  title={`${ui.legalNoticeLabel} — ${SITE.name}`}
  description={`Impressum von ${SITE.brand} ${SITE.name}.`}
  noindex
>
  <div class="container page-content">
    <h1>{ui.legalNoticeLabel}</h1>

    <h2>Webseitenbetreiber</h2>
    <p>
      {SITE.brand} {SITE.name}, {legal.companyType}<br />
      {business.address.street}, {business.address.postalCode}
      {business.address.city}<br />
      Registration number: {legal.registrationNumber}<br />
      Phone: <a href={`tel:${business.phone}`}>{business.phone}</a><br />
      Email: <a href={`mailto:${business.email}`}>{business.email}</a>
    </p>

    <h2>Verantwortlicher für den Inhalt</h2>
    <p>{legal.publisher}</p>

    <h2>Hosting</h2>
    <p>
      {legal.host.name}<br />
      {legal.host.address}<br />
      <a href={legal.host.url} target="_blank" rel="noopener noreferrer">
        {legal.host.url}
      </a>
    </p>

    <h2>Geistiges Eigentum</h2>
    <p>
      Alle Inhalte auf dieser Website (Texte, Bilder, Logo) sind das ausschließliche Eigentum 
      von {SITE.name}, sofern nicht anders angegeben. Jede Vervielfältigung, auch teilweise, 
      bedarf der vorherigen schriftlichen Genehmigung.
    </p>
  </div>
</Base>
