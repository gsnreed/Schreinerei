---
// Free-form pages from src/content/seiten/*.mdx — the filename becomes the
// URL: werkstatt.mdx → /werkstatt/. Layout: back link → eyebrow, heading,
// intro and (optional) large photo → MDX text → (optional) photo grid →
// call to action. Don't name a file like an existing page (projekte,
// leistungen, impressum, datenschutz): the existing page would win.
import Base from "../layouts/Base.astro";
import BackLink from "../components/BackLink.astro";
import CtaBanner from "../components/sections/CtaBanner.astro";
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { SITE } from "../config/site";
import { absoluteUrl, breadcrumbJsonLd, firstThatFits, fitSentences, TITLE_MAX } from "../lib/seo";

export async function getStaticPaths() {
  const pages = await getCollection("seiten");
  return pages.map((page) => ({ params: { seite: page.id }, props: { page } }));
}

interface Props {
  page: CollectionEntry<"seiten">;
}

const { page } = Astro.props;
const { title, description, eyebrow, image, imageAlt, gallery } = page.data;
const { Content } = await render(page);
const { city } = SITE.business.address;

// --- SEO (generated from the frontmatter) ------------------------------------
const seoTitle =
  page.data.seoTitle ??
  firstThatFits(
    [`${title} | ${SITE.shortName}, ${city}`, `${title} | ${SITE.shortName}`],
    TITLE_MAX,
  );
const seoDescription = fitSentences(description);
const path = `/${page.id}/`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${absoluteUrl(path)}#page`,
    name: title,
    description,
    url: absoluteUrl(path),
    inLanguage: SITE.lang,
    isPartOf: { "@id": `${SITE.url}/#website` },
    about: { "@id": `${SITE.url}/#business` },
  },
  breadcrumbJsonLd([
    { name: "Startseite", path: "/" },
    { name: title, path },
  ]),
];
---

<Base
  title={seoTitle}
  description={seoDescription}
  image={image ?? gallery[0]?.image}
  imageAlt={image ? imageAlt : gallery[0]?.alt}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="container page-content content-page">
    <BackLink href="/#about" label={SITE.ui.backToHome} />

    <header class:list={["page-header", { "has-image": image }]}>
      <div>
        {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </div>
      {image && (
        <figure class="page-figure">
          <Image
            src={image}
            alt={imageAlt}
            widths={[400, 560, 720, 960, 1200]}
            sizes="(max-width: 820px) calc(100vw - 3rem), (max-width: 1150px) 45vw, 500px"
            loading="eager"
          />
        </figure>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    {gallery.length > 0 && (
      <section class="page-gallery" aria-label="Fotos">
        {gallery.map((photo) => (
          <figure>
            <Image
              src={photo.image}
              alt={photo.alt}
              width={800}
              height={600}
              fit="cover"
              widths={[360, 480, 640, 800]}
              sizes="(max-width: 600px) calc(100vw - 3rem), (max-width: 1000px) calc(50vw - 2.5rem), 350px"
              loading="lazy"
            />
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}
  </article>

  <CtaBanner />
</Base>

<style>
  .page-header {
    display: grid;
    gap: clamp(var(--space-3), 5vw, calc(var(--space-4) * 1.6));
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .page-header.has-image {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .page-header h1 {
    margin-top: 0;
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: var(--prose-width);
  }

  .page-figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .page-figure :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* MDX body: readable line length; photos written in the text use the
     full column width */
  .prose {
    max-width: var(--prose-width);
  }

  .prose :global(h2) {
    margin-top: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25em;
  }

  .prose :global(li + li) {
    margin-top: 0.35em;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin-block: var(--space-2);
  }

  .page-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-2);
    margin-top: var(--space-section);
  }

  .page-gallery figure {
    margin: 0;
  }

  .page-gallery :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
    display: block;
  }

  .page-gallery figcaption {
    margin-top: 0.4rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 820px) {
    .page-header.has-image {
      grid-template-columns: minmax(0, 1fr);
    }

    .page-figure {
      order: -1;
    }
  }
</style>
