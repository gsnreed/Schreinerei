---
// Service detail page — one template for every MDX file in
// src/content/services/. The filename becomes the URL: /services/<filename>/.
import Base from "../../layouts/Base.astro";
import BackLink from "../../components/BackLink.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
import { SITE } from "../../config/site";
import { getServices, serviceUrl, type Service } from "../../lib/services";
import { render } from "astro:content";
import { getProjectsForService, projectCategoryUrl } from "../../lib/projects";

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { title, description } = service.data;
const { Content } = await render(service);
const projects = await getProjectsForService(service.id);

const jsonLdService = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: title,
  description,
  url: new URL(serviceUrl(service), SITE.url).href,
  areaServed: SITE.business.areaServed,
  provider: { "@id": `${SITE.url}/#business` },
};
---

<Base title={`${title} — ${SITE.brand} ${SITE.name}`} description={description}>
  <article class="container page-content service-page">
    <BackLink href="/#services" label={SITE.ui.backToServices} />

    <header class="service-header">
      <div>
        {SITE.services.eyebrow && (
          <p class="section-eyebrow">{SITE.services.eyebrow}</p>
        )}
        <h1 class="service-title" transition:name={`service-title-${service.id}`}>
          {title}
        </h1>
      </div>
    </header>

    <p class="lead">{description}</p>

    <div class="prose">
      <Content />
    </div>
  </article>

  {projects.length > 0 && (
    <section class="section service-projects" aria-labelledby="service-projects-title">
      <div class="container service-page">
        <h2 id="service-projects-title">{SITE.ui.serviceProjectsTitle}</h2>
        <div class="grid-3">
          {projects.slice(0, 3).map((project) => <ProjectCard project={project} />)}
        </div>
        {projects.length > 3 && (
          <p class="service-projects-more">
            <a class="button button-secondary" href={projectCategoryUrl(service.id)}>
              {SITE.ui.allProjectsLabel.replace("{count}", String(projects.length))}
            </a>
          </p>
        )}
      </div>
    </section>
  )}

  <CtaBanner />
</Base>

<script type="application/ld+json" set:html={JSON.stringify(jsonLdService)} />
<style>
  .service-page {
    max-width: calc(var(--prose-width) + 2 * var(--space-3));
  }

  .service-projects {
    padding-top: 0;
  }

  .service-projects h2 {
    margin-bottom: var(--space-3);
  }

  .service-projects-more {
    margin-top: var(--space-4);
  }

  .service-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .service-header h1 {
    margin: 0;
    width: fit-content; /* tight box for the title morph from the card */
  }

  .service-icon {
    flex: none;
    color: #fff;
    background: var(--gradient-icon);
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(146, 64, 14, 0.3);
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .prose :global(h2) {
    margin-top: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25em;
  }

  .prose :global(li + li) {
    margin-top: 0.35em;
  }
</style>
