---
// Service detail page — one template for every MDX file in
// src/content/services/. The filename becomes the URL: /leistungen/<filename>/.
import Base from "../../layouts/Base.astro";
import BackLink from "../../components/BackLink.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CtaBanner from "../../components/sections/CtaBanner.astro";
import { SITE } from "../../config/site";
import { getServices, serviceUrl, type Service } from "../../lib/services";
import { render } from "astro:content";
import { getProjectsForService, projectCategoryUrl } from "../../lib/projects";
import { getImage } from "astro:assets";
import {
  absoluteUrl,
  breadcrumbJsonLd,
  firstThatFits,
  fitSentences,
  TITLE_MAX,
} from "../../lib/seo";

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { title, description } = service.data;
const { Content } = await render(service);
const projects = await getProjectsForService(service.id);

// --- SEO -------------------------------------------------------------------
// Generated from the MDX frontmatter; `seoTitle` / `seoDescription` in the
// frontmatter override them for a single service.
const { city } = SITE.business.address;

// "Küchen nach Maß in Pocking | Schreinerei Siegfried"
const seoTitle =
  service.data.seoTitle ??
  firstThatFits(
    [
      `${title} in ${city} | ${SITE.shortName}`,
      `${title} | ${SITE.shortName}, ${city}`,
      `${title} | ${SITE.shortName}`,
    ],
    TITLE_MAX,
  );

// As many whole sentences of the description as fit, plus the place:
// "Wir planen die Küche … Schreinerei Siegfried aus Pocking."
const seoDescription =
  service.data.seoDescription ??
  fitSentences(description, `${SITE.shortName} aus ${city}.`);

// Share image: photo of the first project for this service, else the hero
const shareImage = projects[0]?.data.image;
const shareImageAlt = projects[0]?.data.imageAlt;
const pageUrl = absoluteUrl(serviceUrl(service));
const jsonLdImage = shareImage
  ? absoluteUrl((await getImage({ src: shareImage, width: 1200, format: "jpg" })).src)
  : undefined;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: title,
    serviceType: title,
    description,
    url: pageUrl,
    ...(jsonLdImage && { image: jsonLdImage }),
    areaServed: SITE.business.areaServed,
    provider: { "@id": `${SITE.url}/#business` },
  },
  breadcrumbJsonLd([
    { name: "Startseite", path: "/" },
    { name: "Leistungen", path: "/#services" },
    { name: title, path: serviceUrl(service) },
  ]),
];
---

<Base
  title={seoTitle}
  description={seoDescription}
  image={shareImage}
  imageAlt={shareImageAlt}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="container page-content service-page">
    <BackLink href="/#services" label={SITE.ui.backToServices} />

    <header class="service-header">
      <div>
        {SITE.services.eyebrow && (
          <p class="section-eyebrow">{SITE.services.eyebrow}</p>
        )}
        <h1 class="service-title" transition:name={`service-title-${service.id}`}>
          {title}
        </h1>
      </div>
    </header>

    <p class="lead">{description}</p>

    <div class="prose">
      <Content />
    </div>
  </article>

  {projects.length > 0 && (
    <section class="section service-projects" aria-labelledby="service-projects-title">
      <div class="container service-page">
        <h2 id="service-projects-title">{SITE.ui.serviceProjectsTitle}</h2>
        <div class="grid-3">
          {projects.slice(0, 3).map((project) => <ProjectCard project={project} />)}
        </div>
        {projects.length > 3 && (
          <p class="service-projects-more">
            <a class="button button-secondary" href={projectCategoryUrl(service.id)}>
              {SITE.ui.allProjectsLabel.replace("{count}", String(projects.length))}
            </a>
          </p>
        )}
      </div>
    </section>
  )}

  <CtaBanner />
</Base>

<style>
  .service-page {
    max-width: calc(var(--prose-width) + 2 * var(--space-3));
  }

  .service-projects {
    padding-top: 0;
  }

  .service-projects h2 {
    margin-bottom: var(--space-3);
  }

  .service-projects-more {
    margin-top: var(--space-4);
  }

  .service-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .service-header h1 {
    margin: 0;
    width: fit-content; /* tight box for the title morph from the card */
  }

  .service-icon {
    flex: none;
    color: #fff;
    background: var(--gradient-icon);
    width: 56px;
    height: 56px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(146, 64, 14, 0.3);
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .prose :global(h2) {
    margin-top: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25em;
  }

  .prose :global(li + li) {
    margin-top: 0.35em;
  }
</style>
