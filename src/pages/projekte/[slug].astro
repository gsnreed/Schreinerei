---
// Project detail page — one page per MDX file in src/content/projects/.
// The filename becomes the URL: /projekte/<filename>/. The page itself is
// src/components/ProjectPage.astro (shared with the photo pages).
import ProjectPage from "../../components/ProjectPage.astro";
import { getProjects, type Project } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, prev: projects[index - 1], next: projects[index + 1] },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}
---

<ProjectPage {...Astro.props} activePhoto={0} />
