---
// Project detail page — one template for every MDX file in
// src/content/projects/. The filename becomes the URL: /projekte/<filename>/.
//
// Layout: back link → text + facts box | main photo (uncropped) → optional
// extra photos → previous / next project. The "similar project?" call to
// action sits right under the facts and pre-fills the contact form.
// Every page has a clear way back, a way onward and a way to get in touch.
import Base from "../../layouts/Base.astro";
import BackLink from "../../components/BackLink.astro";
import { Image } from "astro:assets";
import { SITE } from "../../config/site";
import {
  getProjects,
  projectUrl,
  projectCategoryUrl,
  type Project,
} from "../../lib/projects";
import { serviceUrl } from "../../lib/services";
import { getEntry, render } from "astro:content";
import { getImage } from "astro:assets";
import {
  firstThatFits,
  absoluteUrl,
  breadcrumbJsonLd,
  TITLE_MAX,
  DESCRIPTION_MAX,
} from "../../lib/seo";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[index - 1],
      next: projects[index + 1],
    },
  }));
}

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}

const { project, prev, next } = Astro.props;
const { title, description, image, imageAlt, imagePosition, gallery, location, material } =
  project.data;
const service = await getEntry(project.data.service);
const { Content } = await render(project);
const { ui } = SITE;

// Extra photos: a square thumbnail on the page, linking to the whole photo
// (uncropped, max. 1600 px) so nothing cut off by the square is lost.
const galleryPhotos = await Promise.all(
  gallery.map(async (photo) => ({
    ...photo,
    fullUrl: (await getImage({ src: photo.image, width: Math.min(1600, photo.image.width), format: "webp" })).src,
  })),
);

const inquiryParams = new URLSearchParams({ projekt: title });
if (service) inquiryParams.set("leistung", service.id);
const inquiryHref = `/?${inquiryParams}#contact`;

// --- SEO -------------------------------------------------------------------
// Generated from the MDX frontmatter; `seoTitle` / `seoDescription` in the
// frontmatter override them for a single project.
const { city } = SITE.business.address;
const serviceTitle = service?.data.title;

// Title: the most detailed variant that fits into ~60 characters, e.g.
// "Kochinsel aus Holz – Küchen nach Maß | Schreinerei Siegfried"
const brand = SITE.shortName;
const withService = serviceTitle ? `${title} – ${serviceTitle}` : title;
const seoTitle =
  project.data.seoTitle ??
  firstThatFits(
    [
      `${withService} | ${brand}, ${city}`,
      `${withService} | ${brand}`,
      `${title} | ${brand}, ${city}`,
      `${title} | ${brand}`,
    ],
    TITLE_MAX,
  );

// Description: the project text plus who/where/what, as long as it fits into
// ~158 characters without cutting a sentence:
// "Freistehende Kücheninsel … Küchen nach Maß aus Pocking: Aufmaß, Fertigung
//  und Montage aus einer Hand."
const intro = description.trim().replace(/\.?$/, ".");
const what = serviceTitle ?? "Schreinerarbeiten";
const seoDescription =
  project.data.seoDescription ??
  firstThatFits(
    [
      `${intro} ${what} von der ${SITE.business.name} aus ${city}: Aufmaß, Fertigung und Montage aus einer Hand.`,
      `${intro} ${what} von der ${brand} aus ${city}: Aufmaß, Fertigung und Montage aus einer Hand.`,
      `${intro} ${what} aus ${city}: Aufmaß, Fertigung und Montage aus einer Hand.`,
      `${intro} ${what} von der ${brand} aus ${city}.`,
      `${intro} ${brand}, ${city}.`,
      intro,
    ],
    DESCRIPTION_MAX,
  );

const pageUrl = absoluteUrl(projectUrl(project));
const jsonLdImage = await getImage({ src: image, width: 1200, format: "jpg" });

// schema.org: the project as a piece of work by the business, plus breadcrumbs
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": `${pageUrl}#project`,
    name: title,
    headline: title,
    description,
    url: pageUrl,
    inLanguage: SITE.lang,
    image: {
      "@type": "ImageObject",
      url: absoluteUrl(jsonLdImage.src),
      caption: imageAlt,
    },
    ...(gallery.length > 0 && {
      associatedMedia: await Promise.all(
        gallery.map(async (photo) => ({
          "@type": "ImageObject",
          url: absoluteUrl((await getImage({ src: photo.image, width: 1200, format: "jpg" })).src),
          caption: photo.alt,
        })),
      ),
    }),
    ...(material && { material }),
    ...(location && { locationCreated: { "@type": "Place", name: location } }),
    ...(service && {
      genre: service.data.title,
      about: {
        "@type": "Service",
        name: service.data.title,
        url: absoluteUrl(serviceUrl(service)),
      },
    }),
    creator: { "@id": `${SITE.url}/#business` },
  },
  breadcrumbJsonLd([
    { name: "Startseite", path: "/" },
    { name: SITE.gallery.allTitle, path: "/projekte/" },
    ...(service
      ? [{ name: service.data.title, path: projectCategoryUrl(service.id) }]
      : []),
    { name: title, path: projectUrl(project) },
  ]),
];
---

<Base
  title={seoTitle}
  description={seoDescription}
  image={image}
  imageAlt={imageAlt}
  ogType="article"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="container page-content project-page">
    <BackLink href="/projekte/" label={ui.backToAllProjects} />

    <div class="project-layout">
      <div class="project-info">
        {service && (
          <a class="project-service" href={projectCategoryUrl(service.id)}>
            {service.data.title}
          </a>
        )}
        <h1>{title}</h1>
        <p class="project-description">{description}</p>
        <div class="prose">
          <Content />
        </div>

        <dl class="project-facts">
          {service && (
            <div>
              <dt>{ui.projectServiceLabel}</dt>
              <dd><a href={serviceUrl(service)}>{service.data.title}</a></dd>
            </div>
          )}
          {location && (
            <div>
              <dt>{ui.projectLocationLabel}</dt>
              <dd>{location}</dd>
            </div>
          )}
          {material && (
            <div>
              <dt>{ui.projectMaterialLabel}</dt>
              <dd>{material}</dd>
            </div>
          )}
        </dl>

        <div class="similar-project">
          <p><strong>{ui.similarProjectTitle}</strong> {ui.similarProjectText}</p>
          <a class="button" href={inquiryHref}>{ui.similarProjectCta}</a>
        </div>
      </div>

      <figure class="project-figure">
        <Image
          src={image}
          alt={imageAlt}
          width={1200}
          height={1200}
          fit="cover"
          position={imagePosition}
          widths={[400, 560, 720, 960, 1200]}
          sizes="(max-width: 820px) calc(100vw - 3rem), (max-width: 1150px) 45vw, 500px"
          loading="eager"
          class="project-image"
          transition:name={`project-image-${project.id}`}
        />
      </figure>
    </div>

    {gallery.length > 0 && (
      <section class="project-gallery" aria-labelledby="more-photos">
        <h2 id="more-photos">{ui.projectMorePhotos}</h2>
        <div class="project-gallery-grid">
          {galleryPhotos.map((photo) => (
            <a class="gallery-photo" href={photo.fullUrl} title="Ganzes Foto ansehen">
              <Image
                src={photo.image}
                alt={photo.alt}
                width={600}
                height={600}
                fit="cover"
                position={photo.position}
                widths={[300, 450, 600]}
                sizes="(max-width: 600px) calc(100vw - 3rem), (max-width: 1000px) calc(50vw - 2.5rem), 260px"
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </section>
    )}

    {(prev || next) && (
      <nav class="project-pager" aria-label="Weitere Projekte">
        {prev ? (
          <a class="pager-link pager-prev" href={projectUrl(prev)} rel="prev">
            <span class="pager-label">← {ui.projectPrevLabel}</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a class="pager-link pager-next" href={projectUrl(next)} rel="next">
            <span class="pager-label">{ui.projectNextLabel} →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Base>

<style>
  .project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-3), 5vw, calc(var(--space-4) * 1.6));
    align-items: start;
  }

  .project-info {
    min-width: 0;
  }

  /* Service badge above the title — links to the filtered project list */
  .project-service {
    display: inline-block;
    margin-bottom: var(--space-2);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background-color var(--transition);
  }

  .project-service:hover {
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .project-info h1 {
    margin-top: 0;
  }

  .project-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  /* Facts box */
  .project-facts {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-3) 0;
    padding: var(--space-2) 0;
    border-block: 1px solid var(--color-border);
  }

  .project-facts div {
    display: flex;
    gap: var(--space-2);
  }

  .project-facts dt {
    flex: 0 0 6.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .project-facts dd {
    margin: 0;
    font-weight: 600;
  }

  /* Main photo: square, cropped around `imagePosition` (see content.config.ts) */
  .project-figure {
    margin: 0;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .similar-project p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .similar-project strong {
    color: var(--color-text);
  }

  .project-gallery {
    margin-top: var(--space-section);
  }

  /* Extra photos: square thumbnails, 4 per row on desktop */
  .project-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: var(--space-2);
  }

  .gallery-photo {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .gallery-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 420ms ease;
  }

  @media (hover: hover) {
    .gallery-photo:hover :global(img) {
      transform: scale(1.04);
    }
  }

  /* Previous / next project */
  .project-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }

  .pager-next {
    grid-column: 2;
    text-align: right;
  }

  .pager-label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .pager-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .pager-link:hover .pager-title {
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .project-layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }

  /* Mobile: photo first (it's what people came for), then the text */
  @media (max-width: 820px) {
    .project-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-figure {
      order: -1;
    }
  }
</style>
